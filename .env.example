# Telegram API Credentials
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+1234567890
CHAT_ID=your_chat_id

# Gemini running analysis
GEMINI_API_KEY=your_gemini_api_key
AY_GEMINI_MODEL=gemini-3.8-flash
# Optional fallback, used only if the primary model returns HTTP 404
AY_GEMINI_FALLBACK_MODEL=

# WordPress Configuration
WORDPRESS_URL=https://your-site.com
WORDPRESS_USERNAME=your_username
WORDPRESS_PASSWORD=your_application_password

# Optional: Override default directories
# DOWNLOADS_DIR=/app/downloads
# SESSION_DIR=/app/session
