# Telegram API Credentials
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+1234567890
CHAT_ID=your_chat_id

# Running analysis: gemini, openai, or local (Ollama)
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your_gemini_api_key
AY_GEMINI_MODEL=gemini-3.8-flash
# Optional fallback, used only if the primary model returns HTTP 404
AY_GEMINI_FALLBACK_MODEL=

# OpenAI (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Local Ollama (only used when LLM_PROVIDER=local)
LOCAL_LLM_ENDPOINT=http://ollama:11434/api/generate
LOCAL_LLM_MODEL=gemma4:e4b

# WordPress Configuration
WORDPRESS_URL=https://your-site.com
WORDPRESS_USERNAME=your_username
WORDPRESS_PASSWORD=your_application_password

# Optional: Override default directories
# DOWNLOADS_DIR=/app/downloads
# SESSION_DIR=/app/session
